# Auto detect text files and perform LF normalization
* text=auto

# ---- GitHub Linguist: report this as the Python project it is ----
# The published dashboard is a build artifact: /tmp/dashboard_v2_template.html
# with the analysis payload injected into it. It is 2.4x the size of all the
# Python here, so without this it alone decides the repo's language bar.
# Marking it generated also collapses its 139KB diffs in review.
dashboard/index.html linguist-generated=true

# WATA's published GTFS feed, archived verbatim — third-party data, not our code.
data/gtfs/** linguist-vendored=true

# Derived analysis outputs, all regenerated by src/wata/pipeline.py.
data/processed/** linguist-generated=true
data/raw/** linguist-generated=true
dashboard/data/** linguist-generated=true
